rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config: Allow read/write for active league since app needs to save it
    match /config/activeLeague {
      allow read, write: if true; 
    }
    
    // Credentials: NO client access whatsoever. 
    // This protects your admin credentials from being read or modified by users.
    // Your app will automatically use its hardcoded fallback for login.
    match /config/admin_credentials {
      allow read, write: if false;
    }
    
    // Leagues: public read and write (Required because app uses custom client-side Auth, not Firebase Auth)
    match /leagues/{leagueId} {
      allow read, write: if true;
    }
    
    // Teams: public read and write
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    // Fixtures: public read and write
    match /fixtures/{leagueId} {
      allow read, write: if true;
    }
  }
}
